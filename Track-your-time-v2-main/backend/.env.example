# ---------------------------------------------------------------------------
# Config layering (see app/config.py). Lowest precedence first:
#
#   1. .env         — live / shared defaults (Railway Postgres + Redis)
#   2. .env.local   — YOUR machine's overrides (local Postgres + Redis)
#   3. real env vars — always win; this is what Railway/Vercel inject
#
# So local development = create .env.local. Want to point your local backend at
# the live database instead? Rename .env.local out of the way. No code change.
# On Railway, set variables in the service's Variables tab; no .env is used.
#
# Both .env and .env.local are gitignored. Never commit either.
# ---------------------------------------------------------------------------

# Postgres.
# Inside Railway prefer the INTERNAL hostname (postgres.railway.internal) over
# the public proxy — the proxy measured ~359ms of round trip per query, and
# endpoints make 3-11 queries each.
DATABASE_URL=postgresql+asyncpg://reminder:reminder@postgres:5432/reminder_db
TEST_DATABASE_URL=postgresql+asyncpg://reminder:reminder@postgres:5432/reminder_test_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# LLM providers
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-api-key-here
VOICE_MODEL=gpt-4o-mini

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_SUB=mailto:you@example.com

# CORS — comma-separated list of allowed frontend origins.
# Scheme + host only, no trailing slash and no path.
# The app REFUSES TO BOOT if ENVIRONMENT is not "development" and this still
# contains localhost — a forgotten value here surfaces in the browser as an
# opaque "Network Error" that looks identical to the backend being down.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Reminder repeat cadence.
# A due task re-notifies every REMINDER_REPEAT_MINUTES until the user acts
# (Done, Snooze or Mute). Quiet hours still defer. This is NOT the same as a
# task's own `interval_minutes`, which controls recurrence.
# Set to 1 in development to test the repeat loop without waiting.
REMINDER_REPEAT_MINUTES=10
# Shorter backoff used when every push attempt failed, so a transient outage
# doesn't cost the user a full repeat interval.
REMINDER_RETRY_MINUTES=2

# Misc
GRACE_PERIOD_MINUTES=5
ENVIRONMENT=development
