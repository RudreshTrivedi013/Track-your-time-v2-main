# ---------------------------------------------------------------------------
# Config layering (Vite native). Lowest precedence first:
#
#   1. .env         — live defaults (your deployed Railway backend)
#   2. .env.local   — YOUR machine's overrides (http://127.0.0.1:8000)
#   3. Vercel dashboard variables — win at build time
#
# Local development = create .env.local. Delete it and the app targets live.
# Both files are gitignored.
# ---------------------------------------------------------------------------

# Baked in at BUILD time, and read by the service worker too (notification
# action buttons post directly to this host). Production builds THROW if it is
# unset rather than silently falling back to the frontend's own origin — a
# missing value here used to make POST /auth/login return index.html and
# surface as an unexplainable "Network Error".
#
# No trailing slash. Use 127.0.0.1 (not localhost) locally: uvicorn binds IPv4
# only, and the IPv6-first lookup costs ~205ms per request on Windows.
VITE_API_URL=http://127.0.0.1:8000

# Must match VAPID_PUBLIC_KEY on the backend, or the browser rejects every
# push subscription.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
